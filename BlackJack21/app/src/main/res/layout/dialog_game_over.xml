<?xml version="1.0" encoding="utf-8"?>
<!-- Fin de partida por falta de fichas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/panel_padding">

    <com.example.blackjack21.view.GoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/game_over_title"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:id="@+id/game_over_message"
        android:text="@string/game_over_message"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/panel_padding"
        android:clipChildren="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_game_over_menu"
            style="@style/Widget.BlackJack21.CasinoButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_button_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/game_over_menu"
            app:autoSizeMaxTextSize="@dimen/menu_button_text"
            app:autoSizeMinTextSize="@dimen/dialog_button_min_text"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_game_over_restart"
            style="@style/Widget.BlackJack21.CasinoButton.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_button_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/game_over_restart"
            app:autoSizeMaxTextSize="@dimen/menu_button_text"
            app:autoSizeMinTextSize="@dimen/dialog_button_min_text"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
</LinearLayout>
