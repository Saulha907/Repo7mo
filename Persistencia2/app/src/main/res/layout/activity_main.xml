<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <!-- Organiza los elementos verticalmente. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Título principal. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Persistencia"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:gravity="center"/>

        <!-- Subtítulo de la actividad. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CRUD con Java y Supabase"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Captura del nombre del producto. -->
        <EditText
            android:id="@+id/edtProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del producto"
            android:inputType="textCapSentences"
            android:padding="12dp"/>

        <!-- Captura de la descripción. -->
        <EditText
            android:id="@+id/edtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="1"
            android:padding="12dp"/>

        <!-- Captura del precio. -->
        <EditText
            android:id="@+id/edtPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precio"
            android:inputType="numberDecimal"
            android:padding="12dp"/>

        <!-- Botón para insertar datos. -->
        <Button
            android:id="@+id/btnAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar producto"/>

        <!-- Botón para consultar datos. -->
        <Button
            android:id="@+id/btnConsultar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consultar productos"/>

        <!-- Botón para actualizar un producto. -->
        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualizar producto"/>

        <!-- Botón para eliminar un producto. -->
        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar producto"/>

        <!-- Muestra el estado de la conexión. -->
        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectando con Supabase..."
            android:textColor="#16803C"
            android:gravity="center"
            android:padding="12dp"/>

        <!-- Título del listado. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Productos registrados"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>

        <!-- Lista que mostrará los productos. -->
        <ListView
            android:id="@+id/listaProductos"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#FFFFFF"
            android:dividerHeight="1dp"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>
</ScrollView>
