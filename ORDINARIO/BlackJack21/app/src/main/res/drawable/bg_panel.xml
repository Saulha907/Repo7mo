<?xml version="1.0" encoding="utf-8"?>
<!-- Panel de diálogo: fondo verde profundo con marco dorado. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="@dimen/panel_corner" />
            <gradient android:angle="315" android:centerColor="@color/gold"
                android:endColor="@color/gold_dark" android:startColor="@color/gold_light" />
        </shape>
    </item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape>
            <corners android:radius="@dimen/panel_corner" />
            <gradient android:angle="270" android:endColor="@color/background_dark"
                android:startColor="@color/panel_top" />
        </shape>
    </item>
    <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
        <shape>
            <corners android:radius="@dimen/button_corner" />
            <stroke android:width="1dp" android:color="#66D4AF37" />
        </shape>
    </item>
</layer-list>
