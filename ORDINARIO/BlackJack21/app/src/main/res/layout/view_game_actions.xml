<?xml version="1.0" encoding="utf-8"?>
<!-- Botones de acción del jugador. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/game_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_hit"
        style="@style/Widget.BlackJack21.CasinoButton.Compact"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_action_height"
        android:text="@string/action_hit" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_stand"
        style="@style/Widget.BlackJack21.CasinoButton.Compact"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_action_height"
        android:layout_marginTop="@dimen/game_action_spacing"
        android:text="@string/action_stand" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_double"
        style="@style/Widget.BlackJack21.CasinoButton.Compact"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_action_height"
        android:layout_marginTop="@dimen/game_action_spacing"
        android:text="@string/action_double" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_split"
        style="@style/Widget.BlackJack21.CasinoButton.Compact"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_action_height"
        android:layout_marginTop="@dimen/game_action_spacing"
        android:text="@string/action_split" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_insurance"
        style="@style/Widget.BlackJack21.CasinoButton.Compact"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_action_height"
        android:layout_marginTop="@dimen/game_action_spacing"
        android:text="@string/action_insurance" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_deal"
        style="@style/Widget.BlackJack21.CasinoButton.Compact.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/game_action_height"
        android:layout_marginTop="@dimen/game_action_spacing"
        android:text="@string/action_deal" />
</LinearLayout>
