<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo de confirmación de salida. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/panel_padding">

    <com.example.blackjack21.view.GoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/exit_title"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/exit_message"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/panel_padding"
        android:clipChildren="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_exit_cancel"
            style="@style/Widget.BlackJack21.CasinoButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_button_height"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/exit_cancel" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_exit_confirm"
            style="@style/Widget.BlackJack21.CasinoButton.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/menu_button_height"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="@string/exit_confirm" />
    </LinearLayout>
</LinearLayout>
