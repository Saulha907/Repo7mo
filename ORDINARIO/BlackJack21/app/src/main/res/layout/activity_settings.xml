<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración: efectos de sonido y volumen, con la estética del menú. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.blackjack21.view.CasinoBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/screen_padding">

        <com.example.blackjack21.view.GoldTextView
            android:id="@+id/settings_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/placeholder_title_height"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/settings_title"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="@dimen/menu_title_max_text"
            app:autoSizeMinTextSize="@dimen/menu_title_min_text"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/settings_panel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_percent="0.85" />

        <LinearLayout
            android:id="@+id/settings_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="@dimen/panel_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/panel_padding"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toTopOf="@id/button_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/settings_title"
            app:layout_constraintWidth_max="@dimen/settings_panel_max_width"
            app:layout_constraintWidth_percent="0.7">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:text="@string/settings_section_audio"
                android:textAllCaps="true"
                android:textColor="@color/gold"
                android:textSize="@dimen/settings_section_text"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_sound"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height"
                android:fontFamily="serif"
                android:text="@string/settings_sound_effects"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/settings_row_text"
                app:thumbTint="@color/settings_switch_thumb"
                app:trackTint="@color/settings_switch_track" />

            <LinearLayout
                android:id="@+id/row_volume"
                android:layout_width="match_parent"
                android:layout_height="@dimen/settings_row_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/settings_volume"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/settings_row_text" />

                <SeekBar
                    android:id="@+id/seek_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressBackgroundTint="@color/gold_deep"
                    android:progressTint="@color/gold"
                    android:thumbTint="@color/gold_light" />

                <TextView
                    android:id="@+id/text_volume"
                    android:layout_width="@dimen/settings_value_width"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:gravity="end"
                    android:textColor="@color/gold_light"
                    android:textSize="@dimen/settings_row_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_back"
            style="@style/Widget.BlackJack21.CasinoButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/menu_button_height"
            android:layout_marginTop="@dimen/screen_padding"
            android:text="@string/action_back_to_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/settings_panel" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
