<?xml version="1.0" encoding="utf-8"?>
<!-- Una estadística: valor grande dorado y etiqueta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_stat_card"
    android:gravity="center"
    android:minHeight="@dimen/stat_card_min_height"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/gold_light"
        android:textSize="@dimen/stat_value_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stat_label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stat_label_height"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/stat_label_text"
        app:autoSizeMaxTextSize="@dimen/stat_label_text"
        app:autoSizeMinTextSize="@dimen/stat_label_min_text"
        app:autoSizeStepGranularity="0.5sp"
        app:autoSizeTextType="uniform" />
</LinearLayout>
