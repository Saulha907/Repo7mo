<?xml version="1.0" encoding="utf-8"?>
<!-- Alternativa vertical: mesa arriba, fichas y acciones abajo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_room"
    tools:context=".ui.GameActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/game_padding">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_menu"
            style="@style/Widget.BlackJack21.CasinoButton.Compact"
            android:layout_width="@dimen/game_action_width"
            android:layout_height="@dimen/game_action_height"
            android:text="@string/game_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.example.blackjack21.view.table.TableView
            android:id="@+id/table_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/game_column_gap"
            app:layout_constraintBottom_toTopOf="@id/chip_rack"
            app:layout_constraintDimensionRatio="W,1:1.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_menu" />

        <TextView
            android:id="@+id/game_status"
            style="@style/Widget.BlackJack21.StatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/table_view"
            app:layout_constraintEnd_toEndOf="@id/table_view"
            app:layout_constraintStart_toStartOf="@id/table_view" />

        <include
            android:id="@+id/chip_rack"
            layout="@layout/view_chip_rack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/game_column_gap"
            app:layout_constraintBottom_toTopOf="@id/game_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/table_view" />

        <include
            android:id="@+id/game_actions"
            layout="@layout/view_game_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/game_column_gap"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chip_rack"
            app:layout_constraintWidth_max="560dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
