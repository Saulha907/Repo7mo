<?xml version="1.0" encoding="utf-8"?>
<!-- DrawerLayout permite arrastrar/abrir un panel de navegación lateral. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#0D1B2A">
    <!-- Contenido principal, visible cuando el menú está cerrado. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/btnMenu" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="☰  MENÚ DE SENSORES"
            android:textAllCaps="false" android:textColor="#081A23"
            android:backgroundTint="#35C7B2" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sensores Android" android:textColor="#FFFFFF"
            android:textStyle="bold" android:textSize="30sp" android:layout_marginTop="48dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Explora los sensores de tu dispositivo desde el menú lateral."
            android:textColor="#B7C9D8" android:textSize="17sp" android:layout_marginTop="16dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="6 actividades independientes • Java + XML"
            android:padding="22dp" android:layout_marginTop="32dp"
            android:background="@drawable/rounded_panel" android:textColor="#35C7B2"/>
    </LinearLayout>
    <!-- Panel que sale del borde izquierdo. -->
    <ScrollView android:layout_width="290dp" android:layout_height="match_parent"
        android:layout_gravity="start" android:background="#172A42" android:fillViewport="true">
        <LinearLayout android:orientation="vertical" android:padding="18dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="NAVEGACIÓN" android:textStyle="bold" android:textSize="21sp"
                android:textColor="#35C7B2" android:padding="14dp"/>
            <Button android:id="@+id/navAcelerometro" style="@style/DrawerButton" android:text="1. Acelerómetro"/>
            <Button android:id="@+id/navPodometro" style="@style/DrawerButton" android:text="2. Podómetro"/>
            <Button android:id="@+id/navGiroscopio" style="@style/DrawerButton" android:text="3. Giroscopio"/>
            <Button android:id="@+id/navCamara" style="@style/DrawerButton" android:text="4. Cámara"/>
            <Button android:id="@+id/navGps" style="@style/DrawerButton" android:text="5. GPS"/>
            <Button android:id="@+id/navMagnetometro" style="@style/DrawerButton" android:text="6. Magnetómetro"/>
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
